; /etc/bind/db.home.arpa (example zone file)
; Full names end with a dot. Raise the serial by 1 on every edit (today's date + 2-digit counter).
$TTL 1h
@       IN SOA  ns1.home.arpa. admin.home.arpa. (
                2026112301 ; serial
                1h         ; refresh
                15m        ; retry
                1w         ; expire
                1h )       ; negative cache TTL
@       IN NS   ns1.home.arpa.
ns1     IN A    192.168.1.10
nas     IN A    192.168.1.20
printer IN A    192.168.1.30
